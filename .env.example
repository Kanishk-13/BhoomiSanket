# BhoomiSanket Environment Configuration
# Copy this file to .env and fill in the values

# Application
APP_ENV=development
APP_NAME=BhoomiSanket
APP_VERSION=1.0.0

# Database (PostgreSQL + PostGIS)
# Format: postgresql+asyncpg://user:password@host:port/database
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/bhoomi_sanket

# Authentication
# Generate a secure random key: openssl rand -hex 32
JWT_SECRET_KEY=your-super-secret-jwt-key-change-in-production-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
BCRYPT_ROUNDS=12

# ML Service (External Inference API)
# Leave empty to use loaded model artifact or mock stub
ML_SERVICE_URL=
ML_TIMEOUT_SECONDS=5
ML_FEATURE_SCHEMA_VERSION=1.0
ML_MODEL_PATH=/app/models/land_acquisition_delay_model.pkl
ML_DECISION_THRESHOLD=0.375

# Email (SMTP) - for alert notifications
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_FROM=alerts@bhoomisanket.example
EMAIL_USE_TLS=true

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# Risk Thresholds (configurable via Admin panel)
RISK_THRESHOLD_LOW=0.3
RISK_THRESHOLD_MEDIUM=0.5
RISK_THRESHOLD_HIGH=0.7
RISK_THRESHOLD_CRITICAL=0.9

# Pagination
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100